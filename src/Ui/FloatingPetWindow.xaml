<Window x:Class="PokeTokenBar.Ui.FloatingPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" Title="PokeTokenBar pet"
        UseLayoutRounding="True">
    <Grid x:Name="Root"
          MouseLeftButtonDown="OnMouseLeftDown"
          MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseLeftUp">
        <Image x:Name="SpriteImage" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <TextBlock x:Name="PlaceholderText" Text="🥚" FontSize="58"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open _dashboard" Click="OnOpenDashboardClick" />
            <Separator />
            <MenuItem Header="_Hide pet" Click="OnHidePetClick" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
