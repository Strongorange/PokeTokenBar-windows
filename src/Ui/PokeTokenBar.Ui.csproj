<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PokeTokenBar</AssemblyName>
    <RootNamespace>PokeTokenBar.Ui</RootNamespace>
    <StartupObject>PokeTokenBar.Ui.Program</StartupObject>
    <Version>0.29.1</Version>
    <ApplicationIcon>..\..\assets\pokeball.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 큰 객체 영역(LOH)의 빈 공간이 많으면 GC 가 압축해 Windows 에 돌려줌 -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\PokeTokenBar.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\pokeball.ico" Link="Assets\pokeball.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PokeTokenBar.Ui.Tests" />
  </ItemGroup>

</Project>
