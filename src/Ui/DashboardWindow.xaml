<Window x:Class="PokeTokenBar.Ui.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeTokenBar"
        Width="640" Height="800"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" x:Name="UpdateBanner" Visibility="Collapsed"
                Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="UpdateBannerText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="UpdateSkipButton" MinWidth="100" Click="OnUpdateSkipClick" />
                    <Button x:Name="UpdateInstallButton" Margin="6,0,0,0" MinWidth="80"
                            Style="{StaticResource AccentButton}" Click="OnUpdateInstallClick" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="_Usage">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10"
                            x:Name="TrendSection">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="TrendCaptionLabel" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="TrendPeakValue" DockPanel.Dock="Right" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="TrendPeakLabel" DockPanel.Dock="Right" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,5,0"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="TrendReadout" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid x:Name="TrendBarsHost" Height="26" />
                            <Grid x:Name="TrendTicksHost" Height="1.5" Margin="0,1,0,0" />
                            <Grid x:Name="TrendAxisHost" Margin="0,2,0,0" />
                            <StackPanel x:Name="TrendModelsHost" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="ProvidersHeader" Style="{StaticResource SectionHeader}"
                                       Margin="0" />
                            <ListBox x:Name="ProvidersList" FontSize="12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="CombinedHeader" Style="{StaticResource SectionHeader}"
                                       Margin="0" />
                            <TextBlock x:Name="CombinedText" FontSize="16" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="_Game">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="64" Height="64" CornerRadius="8"
                                    Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                                <Grid>
                                    <Image x:Name="CompanionSprite" Width="64" Height="64"
                                           Stretch="Uniform" Visibility="Collapsed" />
                                    <TextBlock x:Name="CompanionSpritePlaceholder" Text="🥚"
                                               FontSize="30" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel>
                                    <Border x:Name="RarityCapsule" DockPanel.Dock="Right"
                                            CornerRadius="9" Padding="6,1" Margin="8,0,0,1"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="RarityCapsuleText" FontSize="8"
                                                   FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Name="CompanionName" Text="Token Egg" FontSize="18"
                                               FontWeight="SemiBold" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock x:Name="CompanionDetail" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Border x:Name="StatusCapsule" CornerRadius="8" Padding="6,1"
                                            Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="StatusCapsuleText" FontSize="8"
                                                   FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="CombatText" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ProgressLabel" FontSize="12" />
                            <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="1"
                                         Margin="0,6,0,0" />
                            <ScrollViewer x:Name="EvolutionScroll" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                                <StackPanel x:Name="EvolutionLine" Orientation="Horizontal" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="EventsHeader" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ExportButton" Content="E_xport save…" Margin="12,0,0,0"
                                    MinWidth="90" Click="OnExportClick" />
                            <Button x:Name="ImportButton" Content="_Import save…" Margin="6,0,0,0"
                                    MinWidth="90" Click="OnImportClick" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ShopHeader" Text="Bag" FontWeight="SemiBold"
                                       FontSize="13" />
                            <StackPanel x:Name="BagCards" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8" Margin="0,8,0,0">
                        <ListBox x:Name="EventsList" FontSize="11" />
                    </Border>
                    <TextBlock Grid.Row="5" x:Name="GameFooter" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="_Dex">
                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="DexHeader" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel x:Name="DexRarityFilter" Orientation="Horizontal"
                                        Margin="0,6,0,0" />
                        </StackPanel>
                        <ListBox Grid.Row="1" x:Name="DexList">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"
                                       BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="0" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnDexDoubleClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Border Grid.Row="1" x:Name="DexEmpty" Visibility="Collapsed"
                                Padding="0,40,0,40">
                            <StackPanel>
                                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                                    <Image x:Name="DexEmptySprite" Width="96" Height="96"
                                           Stretch="Uniform" Visibility="Collapsed" />
                                    <TextBlock x:Name="DexEmptyPlaceholder" Text="❔" FontSize="40"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="DexEmptyTitle" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock x:Name="DexEmptyHint" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="_Shop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="SpendableLabel" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="SpendableAmount" FontSize="24" FontWeight="Bold"
                                       FontFamily="Consolas" />
                            <TextBlock x:Name="ShopHintText" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel x:Name="ShopCards" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="_Settings…"
                    Margin="0,0,6,0" MinWidth="80" Click="OnSettingsClick" />
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="_Refresh" MinWidth="80"
                    Click="OnRefreshClick" />
            <TextBlock x:Name="RefreshedText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>
    </Grid>
</Window>
