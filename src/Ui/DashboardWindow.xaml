<Window x:Class="PokeTokenBar.Ui.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeTokenBar"
        Width="360" Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Providers" FontWeight="Bold" Margin="0,0,0,6" />
        <ListBox Grid.Row="1" x:Name="ProvidersList" />
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,10,0,8" Padding="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Combined" FontWeight="Bold" />
                <TextBlock x:Name="CombinedText" FontSize="16" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="_Refresh" MinWidth="80" Click="OnRefreshClick" />
            <TextBlock x:Name="RefreshedText" VerticalAlignment="Center" Foreground="#666" />
        </DockPanel>
    </Grid>
</Window>
