<Window x:Class="PokeTokenBar.Ui.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeTokenBar"
        Width="580" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" x:Name="MainTabs">
            <TabItem Header="_Usage">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" x:Name="TrendSection" Margin="0,0,0,10">
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock x:Name="TrendCaptionLabel" FontSize="10" Foreground="#666"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TrendPeakValue" DockPanel.Dock="Right" FontSize="10"
                                       FontWeight="SemiBold" Foreground="#666"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TrendPeakLabel" DockPanel.Dock="Right" FontSize="10"
                                       Foreground="#999" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TrendReadout" FontSize="10" Foreground="#666"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid x:Name="TrendBarsHost" Height="26" />
                        <Grid x:Name="TrendTicksHost" Height="1.5" Margin="0,1,0,0" />
                        <Grid x:Name="TrendAxisHost" Margin="0,2,0,0" />
                        <StackPanel x:Name="TrendModelsHost" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Name="ProvidersHeader" Text="Providers" FontWeight="Bold" Margin="0,0,0,6" />
                    <ListBox Grid.Row="2" x:Name="ProvidersList" />
                    <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="CombinedHeader" Text="Combined" FontWeight="Bold" />
                            <TextBlock x:Name="CombinedText" FontSize="16" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="_Game">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Grid Width="64" Height="64" Margin="0,0,10,0">
                            <Image x:Name="CompanionSprite" Width="64" Height="64"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <TextBlock x:Name="CompanionSpritePlaceholder" Text="🥚"
                                       FontSize="30" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CompanionName" Text="Token Egg" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="CompanionDetail" Foreground="#666" />
                            <TextBlock x:Name="CombatText" FontSize="11" Foreground="#666" Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock x:Name="ProgressLabel" />
                        <ProgressBar x:Name="ProgressBar" Height="14" Minimum="0" Maximum="1" Margin="0,4,0,0" />
                        <TextBlock x:Name="StageLine" FontSize="11" Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DexHeader" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button x:Name="ExportButton" Content="E_xport save…" Margin="12,0,0,0" MinWidth="90" Click="OnExportClick" />
                            <Button x:Name="ImportButton" Content="_Import save…" Margin="6,0,0,0" MinWidth="90" Click="OnImportClick" />
                        </StackPanel>
                        <TextBlock x:Name="BagText" FontSize="11" Foreground="#666" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ShopHeader" Text="Shop" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button x:Name="BuyButton" Content="_Buy selected" Margin="10,0,0,0" MinWidth="90" Click="OnBuyClick" />
                            <Button x:Name="UseCandyButton" Content="Use _candy" Margin="6,0,0,0" MinWidth="80" Click="OnUseCandyClick" />
                            <Button x:Name="UseMintButton" Content="Use _mint" Margin="6,0,0,0" MinWidth="70" Click="OnUseMintClick" />
                            <Button x:Name="UseAllButton" Content="Use a_ll" Margin="6,0,0,0" MinWidth="60" Click="OnUseAllCandyClick" />
                        </StackPanel>
                        <ListBox x:Name="ShopList" Height="92" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="GrowthLabel" Text="Growth" VerticalAlignment="Center" FontSize="11" />
                            <Slider x:Name="GrowthSlider" Width="120" Minimum="0.1" Maximum="2"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Margin="6,0,4,0" ValueChanged="OnGrowthDifficultyChanged" />
                            <TextBlock x:Name="GrowthValue" VerticalAlignment="Center" FontSize="11" MinWidth="32" />
                            <TextBlock x:Name="ShopDifficultyLabel" Text="Shop" VerticalAlignment="Center" FontSize="11" Margin="14,0,0,0" />
                            <Slider x:Name="ShopSlider" Width="120" Minimum="0.1" Maximum="2"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Margin="6,0,4,0" ValueChanged="OnShopDifficultyChanged" />
                            <TextBlock x:Name="ShopValue" VerticalAlignment="Center" FontSize="11" MinWidth="32" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PetHeader" Text="Floating pet" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <CheckBox x:Name="PetEnabledCheck"
                                      VerticalAlignment="Center"
                                      Checked="OnPetEnabledChanged" Unchecked="OnPetEnabledChanged" />
                            <TextBlock x:Name="PetSizeLabel" Text="Size" VerticalAlignment="Center" FontSize="11" Margin="14,0,0,0" />
                            <Slider x:Name="PetSizeSlider" Width="120" Minimum="48" Maximum="384"
                                    TickFrequency="8" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Margin="6,0,4,0" ValueChanged="OnPetSizeChanged" />
                            <TextBlock x:Name="PetSizeValue" VerticalAlignment="Center" FontSize="11" MinWidth="36" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" x:Name="DexList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnDexDoubleClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <ListBox Grid.Column="1" x:Name="EventsList" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="6" x:Name="GameFooter" FontSize="11" Foreground="#666" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="_Refresh" MinWidth="80" Click="OnRefreshClick" />
            <TextBlock x:Name="RefreshedText" VerticalAlignment="Center" Foreground="#666" />
        </DockPanel>
    </Grid>
</Window>
