<Window x:Class="PokeTokenBar.Ui.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeTokenBar"
        Width="470" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0">
            <TabItem Header="_Usage">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Providers" FontWeight="Bold" Margin="0,0,0,6" />
                    <ListBox Grid.Row="1" x:Name="ProvidersList" />
                    <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Combined" FontWeight="Bold" />
                            <TextBlock x:Name="CombinedText" FontSize="16" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="_Game">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="CompanionName" Text="Token Egg" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="CompanionDetail" Foreground="#666" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock x:Name="ProgressLabel" />
                        <ProgressBar x:Name="ProgressBar" Height="14" Minimum="0" Maximum="1" Margin="0,4,0,0" />
                        <TextBlock x:Name="StageLine" FontSize="11" Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DexHeader" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="E_xport save…" Margin="12,0,0,0" MinWidth="90" Click="OnExportClick" />
                            <Button Content="_Import save…" Margin="6,0,0,0" MinWidth="90" Click="OnImportClick" />
                        </StackPanel>
                        <TextBlock x:Name="BagText" FontSize="11" Foreground="#666" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shop" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="_Buy selected" Margin="10,0,0,0" MinWidth="90" Click="OnBuyClick" />
                            <Button Content="Use _candy" Margin="6,0,0,0" MinWidth="80" Click="OnUseCandyClick" />
                            <Button Content="Use _mint" Margin="6,0,0,0" MinWidth="70" Click="OnUseMintClick" />
                            <Button Content="Use a_ll" Margin="6,0,0,0" MinWidth="60" Click="OnUseAllCandyClick" />
                        </StackPanel>
                        <ListBox x:Name="ShopList" Height="92" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Growth" VerticalAlignment="Center" FontSize="11" />
                            <Slider x:Name="GrowthSlider" Width="120" Minimum="0.1" Maximum="2"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Margin="6,0,4,0" ValueChanged="OnGrowthDifficultyChanged" />
                            <TextBlock x:Name="GrowthValue" VerticalAlignment="Center" FontSize="11" MinWidth="32" />
                            <TextBlock Text="Shop" VerticalAlignment="Center" FontSize="11" Margin="14,0,0,0" />
                            <Slider x:Name="ShopSlider" Width="120" Minimum="0.1" Maximum="2"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Margin="6,0,4,0" ValueChanged="OnShopDifficultyChanged" />
                            <TextBlock x:Name="ShopValue" VerticalAlignment="Center" FontSize="11" MinWidth="32" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="PetEnabledCheck" Content="Floating pet"
                                      VerticalAlignment="Center"
                                      Checked="OnPetEnabledChanged" Unchecked="OnPetEnabledChanged" />
                            <TextBlock Text="Size" VerticalAlignment="Center" FontSize="11" Margin="14,0,0,0" />
                            <Slider x:Name="PetSizeSlider" Width="120" Minimum="48" Maximum="384"
                                    TickFrequency="8" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Margin="6,0,4,0" ValueChanged="OnPetSizeChanged" />
                            <TextBlock x:Name="PetSizeValue" VerticalAlignment="Center" FontSize="11" MinWidth="36" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" x:Name="DexList" />
                        <ListBox Grid.Column="1" x:Name="EventsList" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="6" x:Name="GameFooter" FontSize="11" Foreground="#666" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="_Refresh" MinWidth="80" Click="OnRefreshClick" />
            <TextBlock x:Name="RefreshedText" VerticalAlignment="Center" Foreground="#666" />
        </DockPanel>
    </Grid>
</Window>
