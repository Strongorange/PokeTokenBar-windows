<Window x:Class="PokeTokenBar.Ui.RecapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage recap" Width="468" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" KeyDown="OnKeyDown"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Chrome: scope segments + period navigation (#367 current-period return). -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" MinWidth="64" MinHeight="28"
                    Click="OnCloseClick" />
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="ScopeButtons" Orientation="Horizontal" />
                <Button x:Name="PreviousButton" MinWidth="46" MinHeight="28" Margin="14,0,0,0"
                        Click="OnPreviousClick" />
                <Button x:Name="CurrentButton" MinWidth="86" MinHeight="28" Margin="6,0,0,0"
                        Click="OnCurrentClick" />
                <Button x:Name="NextButton" MinWidth="46" MinHeight="28" Margin="6,0,0,0"
                        Click="OnNextClick" />
            </StackPanel>
        </DockPanel>

        <!-- The Pokédex card: fixed explicit palette so it never shifts with the app theme. -->
        <Border Grid.Row="1" x:Name="CardHost" CornerRadius="10" Padding="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D6362E" Offset="0" />
                    <GradientStop Color="#A81F1C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- The hinge side of the case, so the panel reads as a device, not a card. -->
                <Rectangle Grid.Column="0" Fill="Black" Opacity="0.14" RadiusX="2" RadiusY="2" />
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="16" Height="16">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.35,0.3"
                                                     RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Color="#B8E1FF" Offset="0" />
                                    <GradientStop Color="#2673D9" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="White" Opacity="0.9" />
                            </Ellipse.Stroke>
                        </Ellipse>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="6,0,0,0">
                            <Ellipse Width="6" Height="6" Fill="#F25959" />
                            <Ellipse Width="6" Height="6" Fill="#FAD159" Margin="4,0,0,0" />
                            <Ellipse Width="6" Height="6" Fill="#73E080" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="PeriodLabel" Foreground="White" Opacity="0.95"
                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Border CornerRadius="6" Padding="10" Margin="2,0,2,0">
                        <Border.Background>
                            <SolidColorBrush Color="#0D1214" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="Black" Opacity="0.35" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" x:Name="DeltaChip" CornerRadius="3"
                                        Padding="5,2" Visibility="Collapsed">
                                    <TextBlock x:Name="DeltaText" FontFamily="Consolas"
                                               FontSize="9" FontWeight="Bold" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TotalText" FontFamily="Consolas"
                                               FontSize="24" FontWeight="Bold" Foreground="#82FA9E" />
                                    <TextBlock x:Name="TotalUnit" FontFamily="Consolas"
                                               FontSize="7" FontWeight="Medium" Foreground="#82FA9E"
                                               Opacity="0.5" Margin="5,3,0,0"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="CompareNote" FontFamily="Consolas" FontSize="7.5"
                                       Foreground="#82FA9E" Opacity="0.55" Visibility="Collapsed" />
                            <UniformGrid x:Name="Meters" Columns="7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" x:Name="StatsLeft" />
                                <StackPanel Grid.Column="1" x:Name="StatsRight" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="2,0,0,0">
                        <TextBlock x:Name="GraduatesCaption" DockPanel.Dock="Left"
                                   FontFamily="Consolas" FontSize="8" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel x:Name="Graduates" Orientation="Horizontal" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="BestDayLine" Margin="2,8,0,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <DockPanel Grid.Row="3" Margin="2,10,0,0">
            <Button x:Name="CopyButton" DockPanel.Dock="Right" MinWidth="110" MinHeight="26"
                    Click="OnCopyClick" />
            <TextBlock x:Name="CoverageNote" VerticalAlignment="Center" FontSize="10"
                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
